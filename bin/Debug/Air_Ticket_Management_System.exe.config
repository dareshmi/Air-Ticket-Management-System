<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<connectionStrings>
		<add name="AirTicketDB"
             connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=Air_Ticket_Management_System;Integrated Security=True"
             providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>